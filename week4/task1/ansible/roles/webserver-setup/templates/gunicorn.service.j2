[Unit]
Description=gunicorn daemon
After=network.target

[Service]
User=www-data
Group=www-data
Environment="DATABASE_URL=postgres://postgres:password@10.1.2.42:5432/db"
Environment="DJANGO_ALLOWED_HOSTS=*"
WorkingDirectory={{ django_project_dir }}
ExecStart={{ django_project_dir }}/venv/bin/gunicorn mysite.wsgi:application \
--bind 0.0.0.0:8000 \
--workers 3 \
--chdir /opt/sample-django
Restart=always

[Install]
WantedBy=multi-user.target